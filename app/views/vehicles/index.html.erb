<h1>車両一覧（車両 × 現在タンク）</h1>

<%= form_with url: vehicles_path, method: :get, local: true do |f| %>
  営業所: <%= text_field_tag :depot, @depot, size: 10 %>
  検索: <%= text_field_tag :q, @q, placeholder: "ナンバー/メーカー/通称" %>
  <%= submit_tag "絞り込む" %>
  <% if params[:q].present? || params[:depot].present? %>
    <%= link_to "クリア", vehicles_path %>
  <% end %>
<% end %>

<table border="1" cellpadding="6" cellspacing="0" style="border-collapse:collapse; width:100%;">
  <thead style="background:#f5f5f5;">
    <tr>
      <th>営業所</th>
      <th>自動車登録番号</th>
      <th>初度</th>
      <th>経過年数</th>
      <th>輸送品名（現在タンク）</th>
      <th>タンク製造年月日</th>
      <th>タンク経過年数</th>
      <th>シャーシ</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @vehicles.each do |v| %>
      <% t = v.tank %>
      <tr>
        <td><%= v.depot_name %></td>
        <td><%= link_to v.number_plate, vehicle_path(v) %></td>
        <td><%= ym(v.first_registered_on) %></td>
        <td><%= ja_age(v.first_registered_on) %></td>
        <td>
          <% if t %>
            <%= t.current_cargo.presence || "（未設定）" %>
            （<%= link_to t.serial_no, tank_path(t) %>）
          <% else %>
            －
          <% end %>
        </td>
        <td><%= t ? ym(t.first_registered_on) : "" %></td>
        <td><%= t ? ja_age(t.first_registered_on) : "" %></td>
        <td><%= v.axle_config_text %></td>
        <td>
          <% if t %>
            <%= link_to "搭載を変更", edit_tank_path(t) %>
          <% else %>
            <%= link_to "タンクを割り当て", tanks_path(assign_to_vehicle_id: v.id) %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
