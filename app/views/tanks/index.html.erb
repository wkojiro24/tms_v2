<h1>タンク一覧</h1>

<p><%= link_to "新規登録", new_tank_path %></p>

<% target_vehicle_id = params[:assign_to_vehicle_id].presence %>
<% if target_vehicle_id %>
  <div style="margin:8px 0; padding:8px; background:#ffffe0; border:1px solid #ddd;">
    割り当て先の車両ID: <code><%= target_vehicle_id %></code>（この一覧からタンクを選んで割り当て）
  </div>
<% end %>

<table border="1" cellpadding="6" cellspacing="0" style="border-collapse:collapse;">
  <thead style="background:#f5f5f5;">
    <tr>
      <th>ID</th>
      <th>製番</th>
      <th>メーカー</th>
      <th>材質</th>
      <th>室数</th>
      <th>現在の車両</th>
      <th>タンク</th>
      <th>操作</th>
      <% if target_vehicle_id %><th>割り当て</th><% end %>
    </tr>
  </thead>
  <tbody>
    <% @tanks.each do |t| %>
      <tr>
        <td><%= t.id %></td>
        <td><%= t.serial_no %></td>
        <td><%= t.maker %></td>
        <td><%= t.material_detail %></td>
        <td><%= t.compartments %></td>
        <td><%= t.vehicle ? link_to(t.vehicle.number_plate, vehicle_path(t.vehicle)) : "（未搭載）" %></td>
         <td><% t = v.tank %> </td>
        <td>
          <%= link_to "詳細", tank_path(t) %> |
          <%= link_to "編集", edit_tank_path(t) %>
        </td>

        <% if target_vehicle_id %>
          <td>
          <%= button_to "このタンクを割り当て",
                tank_path(t),
                method: :patch,
                params: { tank: { vehicle_id: target_vehicle_id },
                          return_to: vehicles_path },
                form: { data: { turbo_confirm: "車両ID #{target_vehicle_id} に割り当てます。よろしいですか？" } } %>

          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
